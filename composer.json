{
    "name": "trip/core",
    "description": "A lightweight PHP framework for building modern web applications.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Framework\\": "src/",
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "scripts": {
        "test": "phpunit"
    }
}